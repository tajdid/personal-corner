---
/**
 * "Previous" and "Recently" links beneath an article. Blocks with nothing
 * eligible are omitted; ordering comes from src/lib/articles.ts.
 */
import { moreWriting } from '../../lib/articles';
import { routes } from '../../lib/routes';

interface Props {
  slug: string;
}

const { previous, recently } = moreWriting(Astro.props.slug);
const titleLink = 'text-accent hover:underline hover:underline-offset-4';
---

<nav aria-labelledby="more-writing">
  <h2 id="more-writing" class="sr-only">More writing</h2>
  {
    (previous || recently.length > 0) && (
      <div class="grid gap-10 sm:grid-cols-2 sm:gap-12">
        {previous && (
          <div>
            <p class="text-xs text-muted">Previous</p>
            <p class="mt-3 text-lg leading-snug">
              <a href={previous.href} class={titleLink}>
                {previous.title}
              </a>
            </p>
            <p class="mt-1.5 text-[0.9375rem] text-muted">{previous.summary}</p>
          </div>
        )}
        {recently.length > 0 && (
          <div>
            <p class="text-xs text-muted">Recently</p>
            <ul class="mt-3 space-y-3">
              {recently.map((article) => (
                <li class="text-lg leading-snug">
                  <a href={article.href} class={titleLink}>
                    {article.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )
  }
  <p class="mt-10 text-[0.9375rem]">
    <a href={routes.writing} class={titleLink}>
      View all writing <span aria-hidden="true">→</span>
    </a>
  </p>
</nav>
