---
/**
 * Image inside an article, wider than the text column. Pass an imported image
 * as `src` (with `alt`), or `placeholder` text while the image doesn't exist.
 */
import type { ImageMetadata } from 'astro';
import ProjectMedia from '../ProjectMedia.astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  placeholder?: string;
  caption?: string;
  /** Tailwind aspect class; defaults to 3:2. */
  aspect?: string;
}

const { src, alt = '', placeholder = 'Image', caption, aspect = 'aspect-[3/2]' } = Astro.props;
---

<figure class="article-figure">
  <ProjectMedia
    image={src ? { src, alt } : { placeholder }}
    aspect={aspect}
    sizes="(min-width: 68rem) 50rem, 100vw"
  />
  {caption && <figcaption class="mt-3 text-xs text-muted">{caption}</figcaption>}
</figure>
