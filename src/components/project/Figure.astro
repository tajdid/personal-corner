---
/**
 * Full-width project image with optional caption. Pass an imported image as
 * `src` (with `alt`), or `placeholder` text while the image doesn't exist yet.
 */
import type { ImageMetadata } from 'astro';
import ProjectMedia from '../ProjectMedia.astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  placeholder?: string;
  caption?: string;
  /** Tailwind aspect class; defaults to 16:9. */
  aspect?: string;
}

const { src, alt = '', placeholder = 'Image', caption, aspect = 'aspect-[16/9]' } = Astro.props;
---

<figure class="mx-auto max-w-[68rem] px-5 pb-16 sm:px-8 sm:pb-24">
  <ProjectMedia
    image={src ? { src, alt } : { placeholder }}
    aspect={aspect}
    sizes="(min-width: 68rem) 64rem, 100vw"
  />
  {caption && <figcaption class="mt-3 text-xs text-muted">{caption}</figcaption>}
</figure>
