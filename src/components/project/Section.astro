---
/**
 * Story section for project MDX pages: heading in the label column, Markdown
 * body in a readable column. Usage: <Section title="Context">…</Section>
 */
import HomeSection from '../HomeSection.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const id = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<HomeSection id={id} title={title}>
  <div class="prose max-w-[38rem]">
    <slot />
  </div>
</HomeSection>

<style>
  .prose :global(p:not(.placeholder-label)),
  .prose :global(li) {
    font-size: 1.125rem;
    line-height: 1.625;
  }

  .prose :global(* + *) {
    margin-top: 1.25rem;
  }

  .prose :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }

  .prose :global(li + li) {
    margin-top: 0.5rem;
  }

  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
    text-underline-offset: 4px;
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }
</style>
