---
/**
 * Two images side by side (stacked on mobile) with an optional shared caption.
 * Each side takes an imported image (`src` + `alt`) or `placeholder` text.
 */
import type { ImageMetadata } from 'astro';
import ProjectMedia from '../ProjectMedia.astro';

interface Side {
  src?: ImageMetadata;
  alt?: string;
  placeholder?: string;
}

interface Props {
  first: Side;
  second: Side;
  caption?: string;
  /** Tailwind aspect class for both images; defaults to 4:3. */
  aspect?: string;
}

const { first, second, caption, aspect = 'aspect-[4/3]' } = Astro.props;
const toImage = ({ src, alt = '', placeholder = 'Image' }: Side) =>
  src ? { src, alt } : { placeholder };
---

<figure class="mx-auto max-w-[68rem] px-5 pb-16 sm:px-8 sm:pb-24">
  <div class="grid gap-5 sm:grid-cols-2 sm:gap-7">
    {
      [first, second].map((side) => (
        <ProjectMedia
          image={toImage(side)}
          aspect={aspect}
          sizes="(min-width: 68rem) 31rem, (min-width: 40rem) 50vw, 100vw"
        />
      ))
    }
  </div>
  {caption && <figcaption class="mt-3 text-xs text-muted">{caption}</figcaption>}
</figure>
