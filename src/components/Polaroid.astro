---
/**
 * Polaroid-style photograph. Reserved for the About page (docs/DESIGN.md).
 * Square image window with a deeper lower border; the frame scales with the
 * element's width, so callers only set width, rotation and placement.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Rotation in degrees; keep it subtle (roughly ±5). */
  rotate?: number;
  /** `sizes` attribute describing the rendered width at each breakpoint. */
  sizes: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  caption,
  rotate = 0,
  sizes,
  widths = [320, 480, 640, 800],
  priority = false,
  class: className,
} = Astro.props;
---

<figure class:list={['polaroid', className]} style={`rotate: ${rotate}deg`}>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    width={Math.max(...widths)}
    sizes={sizes}
    priority={priority}
    class="aspect-square w-full object-cover"
  />
  <div class="flex aspect-[90/16] items-center px-[4%]">
    {caption && <figcaption class="text-xs leading-snug text-muted">{caption}</figcaption>}
  </div>
</figure>

<style>
  .polaroid {
    /* Off-white photo paper, a shade lighter than the page. Local to this
       component rather than a global palette token. */
    background-color: #fbfaf6;
    padding: 5% 5% 0;
    box-shadow:
      0 1px 2px rgb(23 26 23 / 0.08),
      0 10px 24px -14px rgb(23 26 23 / 0.35);
  }
</style>
