---
import { footerLinks } from '../data/home';

const year = new Date().getFullYear();
// External web links open in a new tab; mailto and internal links don't.
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<footer class="mx-auto max-w-[68rem] px-5 sm:px-8">
  <div
    class="flex flex-col gap-6 border-t border-rule py-8 text-sm sm:flex-row sm:items-baseline sm:justify-between sm:pb-12"
  >
    <ul class="flex flex-wrap gap-x-8 gap-y-2">
      {
        footerLinks.map(({ label, href }) => (
          <li>
            {href ? (
              <a
                href={href}
                class="nav-link"
                target={isExternal(href) ? '_blank' : undefined}
                rel={isExternal(href) ? 'noopener noreferrer' : undefined}
              >
                {label}
                {isExternal(href) && <span class="sr-only">{' (opens in a new tab)'}</span>}
              </a>
            ) : (
              <span class="text-muted">
                {label}
                <span class="sr-only">(link coming soon)</span>
              </span>
            )}
          </li>
        ))
      }
    </ul>
    <p class="text-xs text-muted">* Made slowly, with curiosity. © Taj {year}</p>
  </div>
</footer>
