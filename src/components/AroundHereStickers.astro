---
/**
 * Decorative hover stickers for "Around here" links (CollectionLink or LinkRow
 * with `sticker`). Include once per page. Progressive enhancement: only active
 * with a fine pointer that can hover; otherwise the overlay stays hidden and the
 * links behave normally. The links themselves never move.
 *
 * placement="pointer" (default, homepage): follows the pointer, above and to the
 *   side; disabled under reduced motion.
 * placement="gutter" (About): sits in the empty label column beside the list,
 *   below `gutterHeading`, following the pointer vertically only. Stationary under
 *   reduced motion, hidden on scroll and page exit, off below 48rem.
 */
import { Image } from 'astro:assets';
import music from '../assets/stickers/music.png';
import books from '../assets/stickers/books.png';
import films from '../assets/stickers/films.png';
import games from '../assets/stickers/games.png';
import travel from '../assets/stickers/travel.png';
import bookmarks from '../assets/stickers/bookmarks.png';

interface Props {
  placement?: 'pointer' | 'gutter';
  /** id of the section heading at the top of the gutter column (gutter placement). */
  gutterHeading?: string;
}

const { placement = 'pointer', gutterHeading } = Astro.props;

const MAX_SIDE = 150;
const stickers = { music, books, films, games, travel, bookmarks };

// Display size keeps each illustration's proportions within MAX_SIDE.
const sized = Object.entries(stickers).map(([slug, src], index) => {
  const scale = MAX_SIDE / Math.max(src.width, src.height);
  return {
    slug,
    src,
    width: Math.round(src.width * scale),
    height: Math.round(src.height * scale),
    // A small, fixed tilt per sticker; no continuous motion.
    tilt: index % 2 === 0 ? -4 : 3,
  };
});
---

<div
  class="sticker-overlay"
  data-sticker-overlay
  data-placement={placement}
  data-gutter-heading={gutterHeading}
  aria-hidden="true"
  hidden
>
  {
    sized.map(({ slug, src, width, height, tilt }) => (
      <Image
        src={src}
        alt=""
        width={width}
        height={height}
        densities={[1, 2]}
        loading="lazy"
        decoding="async"
        class="sticker"
        data-sticker={slug}
        data-w={width}
        data-h={height}
        style={`rotate: ${tilt}deg`}
      />
    ))
  }
</div>

<style>
  .sticker-overlay {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 30;
    pointer-events: none;
    opacity: 0;
    transition: opacity 160ms ease-out;
    will-change: transform, opacity;
  }

  .sticker-overlay.is-visible {
    opacity: 1;
  }

  .sticker {
    position: absolute;
    top: 0;
    left: 0;
    max-width: none;
    opacity: 0;
    scale: 0.94;
    transition: scale 200ms ease-out;
    filter: drop-shadow(0 6px 10px rgb(23 26 23 / 0.15));
  }

  /* Only the active sticker shows; switching between links swaps it instantly. */
  .sticker.is-active {
    opacity: 1;
  }

  .sticker-overlay.is-visible .sticker.is-active {
    scale: 1;
  }
</style>

<script>
  const EASE = 0.2;
  const EDGE = 12; // px kept clear of the viewport edges
  const OFFSET_X = 18;
  const OFFSET_Y = 22;
  const GUTTER_GAP = 24; // px kept between a gutter sticker and the list
  const GUTTER_INSET = 16; // px kept below the section heading

  function setup(): () => void {
    const overlay = document.querySelector<HTMLElement>('[data-sticker-overlay]');
    const links = document.querySelectorAll<HTMLAnchorElement>('a[data-sticker-link]');
    if (!overlay || links.length === 0) return () => {};

    const gutter = overlay.dataset.placement === 'gutter';
    const heading = gutter ? document.getElementById(overlay.dataset.gutterHeading ?? '') : null;
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const wideEnough = window.matchMedia('(min-width: 48rem)'); // gutter column exists
    // Pointer placement relies on motion; gutter placement can sit still instead.
    const enabled = () =>
      gutter ? canHover.matches && wideEnough.matches && Boolean(heading) : canHover.matches && !reduceMotion.matches;
    const following = () => !(gutter && reduceMotion.matches);

    const controller = new AbortController();
    const { signal } = controller;

    const images = new Map<string, HTMLImageElement>();
    overlay.querySelectorAll<HTMLImageElement>('img[data-sticker]').forEach((img) => {
      images.set(img.dataset.sticker ?? '', img);
    });

    let activeImg: HTMLImageElement | null = null;
    let activeLink: HTMLAnchorElement | null = null;
    let frame = 0;
    let visible = false;
    // Gutter geometry, measured on enter and after scroll/resize, not on every move.
    let area: { left: number; width: number; top: number; bottom: number } | null = null;
    let rowCentre = 0;
    const target = { x: 0, y: 0 };
    const pos = { x: 0, y: 0 };

    const isReady = (img: HTMLImageElement | null) =>
      Boolean(img && img.complete && img.naturalWidth > 0);

    // Place the sticker above and to the right of the pointer, flipping near edges,
    // so it never sits over the hovered title line.
    function place(clientX: number, clientY: number) {
      if (!activeImg) return;
      const w = Number(activeImg.dataset.w);
      const h = Number(activeImg.dataset.h);
      const vw = document.documentElement.clientWidth;
      const vh = window.innerHeight;
      let x = clientX + OFFSET_X;
      if (x + w > vw - EDGE) x = clientX - OFFSET_X - w;
      let y = clientY - OFFSET_Y - h;
      if (y < EDGE) y = clientY + OFFSET_Y + 8;
      target.x = Math.min(Math.max(x, EDGE), vw - w - EDGE);
      target.y = Math.min(Math.max(y, EDGE), vh - h - EDGE);
    }

    function measureGutter() {
      if (!activeLink || !heading) return;
      const list = activeLink.closest('ul') ?? activeLink;
      const h = heading.getBoundingClientRect();
      const l = list.getBoundingClientRect();
      const r = activeLink.getBoundingClientRect();
      area = {
        left: h.left,
        width: Math.max(0, l.left - GUTTER_GAP - h.left),
        top: h.bottom + GUTTER_INSET,
        bottom: l.bottom,
      };
      rowCentre = r.top + r.height / 2;
    }

    // Gutter placement: inside the empty label column, never over any text; shrinks
    // to the column width and follows the pointer vertically within the list.
    function placeInGutter(clientY: number) {
      if (!activeImg) return;
      if (!area) measureGutter();
      if (!area) return;
      const scale = Math.min(1, area.width / Number(activeImg.dataset.w));
      const w = Number(activeImg.dataset.w) * scale;
      const h = Number(activeImg.dataset.h) * scale;
      activeImg.style.width = `${w}px`;
      activeImg.style.height = `${h}px`;
      const anchor = following() ? clientY : rowCentre;
      const min = Math.max(area.top, EDGE);
      // The small tilt makes the drawn box a few px taller than h; leave room for it.
      const tiltAllowance = Math.ceil(w * 0.07);
      const max = Math.min(area.bottom - h - tiltAllowance, window.innerHeight - h - EDGE);
      target.x = area.left + (area.width - w) / 2;
      target.y = Math.max(min, Math.min(anchor - h / 2, max));
    }

    function tick() {
      frame = 0;
      pos.x += (target.x - pos.x) * EASE;
      pos.y += (target.y - pos.y) * EASE;
      overlay!.style.transform = `translate3d(${pos.x.toFixed(1)}px, ${pos.y.toFixed(1)}px, 0)`;

      const settled = Math.abs(target.x - pos.x) < 0.1 && Math.abs(target.y - pos.y) < 0.1;
      if (!settled) frame = requestAnimationFrame(tick); // stops itself once idle
    }

    const kick = () => {
      if (!following()) {
        // Reduced motion: jump straight to the resting position, no easing.
        pos.x = target.x;
        pos.y = target.y;
        overlay!.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0)`;
        return;
      }
      if (!frame) frame = requestAnimationFrame(tick);
    };

    const position = (event: PointerEvent) =>
      gutter ? placeInGutter(event.clientY) : place(event.clientX, event.clientY);

    function show(img: HTMLImageElement) {
      if (activeImg && activeImg !== img) activeImg.classList.remove('is-active');
      activeImg = img;
      img.classList.add('is-active');
      if (!visible) {
        // Appear at the pointer rather than gliding in from the last position.
        pos.x = target.x;
        pos.y = target.y;
        overlay!.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0)`;
        overlay!.classList.add('is-visible');
        visible = true;
      }
    }

    function hide() {
      overlay!.classList.remove('is-visible');
      visible = false;
    }

    function onEnter(event: PointerEvent) {
      if (!enabled() || event.pointerType !== 'mouse') return;
      const link = event.currentTarget as HTMLAnchorElement;
      activeLink = link;
      area = null;

      const img = images.get(link.dataset.stickerLink ?? '') ?? null;
      if (activeImg && activeImg !== img) activeImg.classList.remove('is-active');
      activeImg = img;
      position(event);
      // A missing or failed illustration just leaves the normal link.
      if (img && isReady(img)) show(img);
      else hide();
      kick();
    }

    function onMove(event: PointerEvent) {
      if (!activeLink || event.currentTarget !== activeLink) return;
      position(event);
      if (activeImg && !visible && isReady(activeImg)) show(activeImg);
      kick();
    }

    function onLeave(event: PointerEvent) {
      if (event.currentTarget !== activeLink) return;
      activeLink = null;
      hide();
    }

    function reset() {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      activeLink = null;
      hide();
    }

    function applyMode() {
      if (enabled()) overlay!.hidden = false; // lazy images load only when enabled
      else {
        reset();
        overlay!.hidden = true;
      }
    }

    links.forEach((link) => {
      link.addEventListener('pointerenter', onEnter, { signal });
      link.addEventListener('pointermove', onMove, { signal });
      link.addEventListener('pointerleave', onLeave, { signal });
    });
    canHover.addEventListener('change', applyMode, { signal });
    reduceMotion.addEventListener('change', applyMode, { signal });
    if (gutter) {
      wideEnough.addEventListener('change', applyMode, { signal });
      // Hide while scrolling; the next pointer move re-measures and shows it again.
      const onScroll = () => {
        area = null;
        hide();
      };
      window.addEventListener('scroll', onScroll, { passive: true, signal });
      window.addEventListener('resize', onScroll, { passive: true, signal });
      window.addEventListener('pagehide', reset, { signal });
    }
    applyMode();

    return () => {
      reset();
      controller.abort();
    };
  }

  let cleanup = setup();
  // Re-initialise cleanly if Astro's client-side navigation is ever enabled.
  document.addEventListener('astro:before-swap', () => cleanup());
  document.addEventListener('astro:page-load', () => {
    cleanup();
    cleanup = setup();
  });
</script>
