---
/**
 * Compact side-project row: thumbnail, title and summary linking to the
 * project's own page, and an optional year.
 */
import ProjectMedia from './ProjectMedia.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';
import type { Project } from '../lib/projects';

type Props = Pick<Project, 'href' | 'title' | 'summary' | 'year' | 'image' | 'placeholder'>;

const { href, title, summary, year, image, placeholder } = Astro.props;
const meta = year ? String(year) : '';
const label = placeholder ? 'Sample project' : undefined;
---

<li class="group relative grid grid-cols-[5rem_minmax(0,1fr)] gap-x-4 border-b border-rule py-5 sm:grid-cols-[6.5rem_minmax(0,1fr)_auto] sm:gap-x-6">
  <div aria-hidden="true" class="self-start">
    {
      'src' in image ? (
        <ProjectMedia image={image} aspect="aspect-[4/3]" sizes="6.5rem" decorative />
      ) : (
        <ImagePlaceholder bare class="aspect-[4/3]" />
      )
    }
  </div>
  <div class="self-center">
    {label && <p class="mb-1 text-xs text-muted">{label}</p>}
    <h3 class="text-lg leading-snug">
      <a href={href} class="stretched-link text-accent underline-offset-4 group-hover:underline">
        {title}
      </a>
    </h3>
    <p class="mt-1 text-[0.9375rem] text-muted">{summary}</p>
    {meta && <p class="mt-1 text-xs text-muted sm:hidden">{meta}</p>}
  </div>
  <div class="hidden items-center gap-4 self-center text-muted sm:flex">
    {meta && <span class="text-xs">{meta}</span>}
    <span aria-hidden="true" class="text-xl text-accent">→</span>
  </div>
</li>
