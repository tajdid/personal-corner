---
/**
 * Editorial section: narrow label column (number, title, note) beside a wider
 * content column. Stacks on small screens. Used on Home and About.
 * Pass `note` as text, or a `slot="note"` element (e.g. a <time>) for markup.
 */
interface Props {
  id: string;
  number?: string;
  title: string;
  note?: string;
}

const { id, number, title, note } = Astro.props;
---

<section aria-labelledby={id} class="mx-auto max-w-[68rem] px-5 sm:px-8">
  <div
    class="border-t border-rule pt-8 pb-16 sm:pt-11 sm:pb-24 md:grid md:grid-cols-[11rem_minmax(0,1fr)] md:gap-x-12"
  >
    <div class="mb-8 md:mb-0">
      <h2 id={id} class="text-[0.9375rem] leading-snug">
        {
          number && (
            <>
              <span class="text-muted">{number}</span>
              <span class="mx-1.5 text-muted">/</span>
            </>
          )
        }<span>{title}</span>
      </h2>
      {
        (note || Astro.slots.has('note')) && (
          <p class="mt-3 text-xs text-muted">
            {note}
            <slot name="note" />
          </p>
        )
      }
    </div>
    <div>
      <slot />
    </div>
  </div>
</section>
