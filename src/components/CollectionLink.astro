---
import type { CollectionPreview } from '../data/home';
import { routes } from '../lib/routes';

type Props = CollectionPreview & {
  /** Opt in to the hover sticker and magnetic title (AroundHereStickers). */
  sticker?: boolean;
};

const { slug, label, description, sticker = false } = Astro.props;
---

<div>
  <h3 class="text-[1.375rem] leading-tight text-accent">
    <!-- The link itself never moves, so the hover and click area stays stationary. -->
    <a href={routes.collection(slug)} class="group" data-sticker-link={sticker ? slug : undefined}>
      <span
        class="inline-block underline-offset-4 group-hover:underline"
        data-magnet={sticker ? '' : undefined}
      >
        <span aria-hidden="true">/{slug}</span><span class="sr-only">{label}</span> <span aria-hidden="true">→</span>
      </span>
    </a>
  </h3>
  <p class="mt-2 text-[0.9375rem] text-muted">{description}</p>
</div>
