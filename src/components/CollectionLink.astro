---
import type { CollectionPreview } from '../data/home';
import { routes } from '../lib/routes';

type Props = CollectionPreview;

const { slug, label, description } = Astro.props;
---

<div>
  <h3 class="text-[1.375rem] leading-tight text-accent">
    <a href={routes.collection(slug)} class="hover:underline hover:underline-offset-4">
      <span aria-hidden="true">/{slug}</span><span class="sr-only">{label}</span> <span aria-hidden="true">→</span>
    </a>
  </h3>
  <p class="mt-2 text-[0.9375rem] text-muted">{description}</p>
</div>
