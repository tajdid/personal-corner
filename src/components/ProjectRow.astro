---
import ProjectMedia from './ProjectMedia.astro';
import { metaLine, type Project } from '../lib/projects';

type Props = Pick<Project, 'href' | 'title' | 'name' | 'summary' | 'disciplines' | 'year' | 'image'> & {
  /** Heading level for the title; h3 under a section h2, h2 directly under the page h1. */
  headingLevel?: 'h2' | 'h3';
};

const { href, title, name, summary, disciplines, year, image, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const meta = metaLine({ disciplines, year });
// Homepage rows use the short project name when one is set.
const label = name ?? title;
---

<!-- The title is the only link; .stretched-link keeps the whole row clickable. -->
<article
  class="group relative grid gap-5 sm:grid-cols-[minmax(10rem,17.5rem)_minmax(0,1fr)] sm:gap-7"
>
  <ProjectMedia
    image={image}
    aspect="aspect-[3/2]"
    sizes="(min-width: 40rem) 17.5rem, 100vw"
    decorative
    class="transition-colors group-hover:border-muted"
  />
  <div class="sm:pt-1">
    {meta && <p class="text-xs text-muted">{meta}</p>}
    <Heading class:list={['text-2xl leading-tight text-accent', meta && 'mt-3']}>
      <a
        href={href}
        class="stretched-link underline-offset-4 group-hover:underline"
      >
        {label} <span aria-hidden="true">→</span>
      </a>
    </Heading>
    <p class="mt-3 max-w-[30rem] leading-relaxed">{summary}</p>
  </div>
</article>
