---
import ImagePlaceholder from './ImagePlaceholder.astro';
import type { ProjectPreview } from '../data/home';
import { routes } from '../lib/routes';

type Props = ProjectPreview;

const { slug, title, meta, summary, imageLabel } = Astro.props;
---

<article>
  <!-- The whole row is one link; the image placeholder is hidden from the accessible name. -->
  <a
    href={routes.project(slug)}
    class="group grid gap-5 sm:grid-cols-[minmax(10rem,17.5rem)_minmax(0,1fr)] sm:gap-7"
  >
    <div aria-hidden="true">
      <ImagePlaceholder
        label={imageLabel}
        class="aspect-[3/2] transition-colors group-hover:border-muted"
      />
    </div>
    <div class="sm:pt-1">
      <p class="text-xs text-muted">{meta}</p>
      <h3
        class="mt-3 text-2xl leading-tight text-accent underline-offset-4 group-hover:underline"
      >
        {title} <span aria-hidden="true">→</span>
      </h3>
      <p class="mt-3 max-w-[30rem] leading-relaxed">{summary}</p>
    </div>
  </a>
</article>
