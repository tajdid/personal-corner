---
import { formatDate, isoDate, type Article } from '../lib/articles';

type Props = Pick<Article, 'href' | 'title' | 'summary' | 'category' | 'publishedAt' | 'placeholder'> & {
  /** h3 under a section h2 (homepage), h2 directly under the page h1 (Writing). */
  headingLevel?: 'h2' | 'h3';
};

const { href, title, summary, category, publishedAt, placeholder, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
// Undated placeholders are labelled rather than given an invented date.
const dateLabel = publishedAt ? undefined : placeholder ? 'Sample article' : undefined;
const hasMeta = Boolean(publishedAt || dateLabel || category);
---

<article class="border-b border-rule pt-5 pb-5 first:pt-0">
  {
    hasMeta && (
      <p class="text-xs text-muted">
        {publishedAt ? <time datetime={isoDate(publishedAt)}>{formatDate(publishedAt)}</time> : dateLabel}
        {(publishedAt || dateLabel) && category && (
          <>
            <span aria-hidden="true" class="mx-1.5">·</span>
            <span class="sr-only">,</span>
          </>
        )}
        {category}
      </p>
    )
  }
  <Heading class:list={['text-2xl leading-tight sm:text-[1.625rem]', hasMeta && 'mt-3']}>
    <a href={href} class="hover:text-accent hover:underline hover:underline-offset-4">
      {title}
    </a>
  </Heading>
  <p class="mt-3 text-muted">{summary}</p>
</article>
