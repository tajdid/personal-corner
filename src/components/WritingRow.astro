---
import type { WritingPreview } from '../data/home';
import { routes } from '../lib/routes';

type Props = WritingPreview;

const { slug, title, description, category, publishedAt } = Astro.props;

const formattedDate = publishedAt?.toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<article class="border-b border-rule pt-5 pb-5 first:pt-0">
  <p class="text-xs text-muted">
    {
      publishedAt ? (
        <time datetime={publishedAt.toISOString().slice(0, 10)}>{formattedDate}</time>
      ) : (
        'Sample entry'
      )
    }<span aria-hidden="true" class="mx-1.5">·</span><span class="sr-only">,</span>{category}
  </p>
  <h3 class="mt-3 text-2xl leading-tight sm:text-[1.625rem]">
    <a href={routes.note(slug)} class="hover:text-accent hover:underline hover:underline-offset-4">
      {title}
    </a>
  </h3>
  <p class="mt-3 text-muted">{description}</p>
</article>
