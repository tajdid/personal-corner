---
/** Neutral stand-in for imagery that hasn't been supplied yet. */
interface Props {
  label?: string;
  /** Frame and corner marks only, for thumbnails too small for text. */
  bare?: boolean;
  class?: string;
}

const { label, bare = false, class: className } = Astro.props;

// Decorative crop marks in each corner; deliberately not "+" so they don't read as controls.
const corners = [
  'top-2 left-2 border-t border-l',
  'top-2 right-2 border-t border-r',
  'bottom-2 left-2 border-b border-l',
  'right-2 bottom-2 border-r border-b',
];
---

<div
  class:list={[
    'relative flex flex-col items-center justify-center gap-1 border border-rule px-6 text-center',
    className,
  ]}
>
  {
    corners.map((position) => (
      <span
        aria-hidden="true"
        class:list={['pointer-events-none absolute size-2 border-muted/50', position]}
      />
    ))
  }
  {
    !bare && (
      <>
        {label && <span class="text-xs text-muted">{label}</span>}
        <span class="text-[0.625rem] tracking-wider text-muted uppercase">Image to come</span>
      </>
    )
  }
</div>
