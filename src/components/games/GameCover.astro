---
/**
 * Game box art inside a consistent portrait area. Covers are contained (never
 * cropped) and sit on a shared baseline, so square Game Boy boxes and tall
 * modern boxes line up. Missing artwork uses the shared placeholder.
 */
import { Image } from 'astro:assets';
import ImagePlaceholder from '../ImagePlaceholder.astro';
import type { Artwork } from '../../data/games';

interface Props {
  artwork?: Artwork;
  label: string;
  sizes: string;
  /**
   * Tailwind aspect class for the artwork area; 'natural' sizes the cover to its own
   * proportions; 'tile' gives every cover the same 3:4 tile (see below).
   */
  aspect?: string;
  /** Decorative when a visible title sits beside the cover; otherwise the cover carries the name. */
  decorative?: boolean;
}

const { artwork, label, sizes, aspect = 'aspect-[3/4]', decorative = true } = Astro.props;

// Tile mode: covers within ~8% of 3:4 fill the tile; other shapes (square Game Boy
// boxes, wide key art) are shown whole over a blurred copy of themselves.
const fillsTile = artwork ? Math.abs(artwork.src.width / artwork.src.height - 0.75) < 0.06 : false;
---

{
  aspect === 'tile' ? (
    <div class="relative isolate aspect-[3/4] overflow-hidden rounded-sm border border-rule bg-ink/5">
      {artwork ? (
        fillsTile ? (
          <Image
            src={artwork.src}
            alt={decorative ? '' : artwork.alt}
            widths={[160, 240, 360, 480]}
            width={Math.min(480, artwork.src.width)}
            sizes={sizes}
            class="size-full object-cover"
          />
        ) : (
          <>
            <Image src={artwork.src} alt="" width={160} class="tile-backdrop absolute inset-0 -z-10 size-full object-cover" />
            <Image
              src={artwork.src}
              alt={decorative ? '' : artwork.alt}
              widths={[160, 240, 360, 480]}
              width={Math.min(480, artwork.src.width)}
              sizes={sizes}
              class="absolute inset-x-0 top-1/2 w-full -translate-y-1/2 shadow-md"
            />
          </>
        )
      ) : (
        <div aria-hidden={decorative ? 'true' : undefined} class="size-full">
          <ImagePlaceholder label={label} class="size-full border-0" />
        </div>
      )}
    </div>
  ) : aspect === 'natural' ? (
    artwork ? (
      <Image
        src={artwork.src}
        alt={decorative ? '' : artwork.alt}
        widths={[160, 240, 360, 480]}
        width={Math.min(480, artwork.src.width)}
        sizes={sizes}
        class="h-auto w-full rounded-sm border border-rule"
      />
    ) : (
      <div aria-hidden={decorative ? 'true' : undefined}>
        <ImagePlaceholder label={label} class="aspect-[3/4]" />
      </div>
    )
  ) : (
    <div class:list={['flex items-end', aspect]}>
      {artwork ? (
        <Image
          src={artwork.src}
          alt={decorative ? '' : artwork.alt}
          widths={[160, 240, 360, 480]}
          width={Math.min(480, artwork.src.width)}
          sizes={sizes}
          class="h-auto max-h-full w-auto max-w-full rounded-sm border border-rule"
        />
      ) : (
        <div aria-hidden={decorative ? 'true' : undefined} class="size-full">
          <ImagePlaceholder label={label} class="size-full" />
        </div>
      )}
    </div>
  )
}

<style>
  .tile-backdrop {
    filter: blur(14px) saturate(1.1);
    transform: scale(1.3);
    opacity: 0.85;
  }
</style>
