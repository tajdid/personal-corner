---
import { Image } from 'astro:assets';
import ImagePlaceholder from './ImagePlaceholder.astro';
import type { LifeLatelyEntry } from '../data/home';

type Props = LifeLatelyEntry;

const { category, title, image, link, placeholderLabel = 'Image' } = Astro.props;
---

<article>
  <p class="text-xs text-muted">{category}</p>
  <div class="mt-3 aspect-square w-full max-w-[18rem] sm:max-w-none">
    {
      image ? (
        <Image
          src={image.src}
          alt={image.alt}
          widths={[240, 360, 480]}
          width={480}
          sizes="(min-width: 64rem) 15rem, (min-width: 40rem) 30vw, 18rem"
          class:list={[
            'size-full border border-rule',
            image.fit === 'contain' ? 'object-contain p-4' : 'object-cover',
          ]}
        />
      ) : (
        <div aria-hidden="true" class="size-full">
          <ImagePlaceholder label={placeholderLabel} class="size-full" />
        </div>
      )
    }
  </div>
  <h3 class="mt-4 text-lg leading-snug">{title}</h3>
  {
    link && (
      <p class="mt-2 text-sm">
        <a href={link.href} class="text-accent hover:underline hover:underline-offset-4">
          {link.label} <span aria-hidden="true">→</span>
        </a>
      </p>
    )
  }
</article>
