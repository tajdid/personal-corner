---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Tajdid Rahman',
  description = "Taj's little corner of the internet.",
} = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Font cssVariable="--font-archivo" preload />
  </head>
  <body class="min-h-dvh bg-paper text-ink">
    <slot />
  </body>
</html>
