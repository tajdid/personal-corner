---
/**
 * Layout for article MDX pages (frontmatter `layout`). Body text sits in a
 * ~65-character column; figures and code blocks may use the full content column.
 */
import PageLayout from './PageLayout.astro';
import AuthorCard from '../components/writing/AuthorCard.astro';
import MoreWriting from '../components/writing/MoreWriting.astro';
import { formatDate, isoDate, slugFromFile, type ArticleFrontmatter } from '../lib/articles';
import { routes } from '../lib/routes';

interface Props {
  frontmatter: ArticleFrontmatter;
  file: string;
}

const { frontmatter, file } = Astro.props;
const { title, summary, category } = frontmatter;
const slug = slugFromFile(file);
const publishedAt = frontmatter.publishedAt
  ? frontmatter.publishedAt instanceof Date
    ? frontmatter.publishedAt
    : new Date(`${frontmatter.publishedAt}T00:00:00Z`)
  : undefined;

const container = 'mx-auto max-w-[68rem] px-5 sm:px-8';
const grid = 'md:grid md:grid-cols-[11rem_minmax(0,1fr)] md:gap-x-12';
---

<PageLayout title={`${title} — Tajdid Rahman`} description={summary}>
  <article class={container}>
    <header class:list={['pt-10 pb-12 sm:pt-14 sm:pb-16', grid]}>
      <div class="md:col-start-2">
        <a href={routes.writing} class="text-sm text-accent hover:underline hover:underline-offset-4">
          <span aria-hidden="true">←</span> Back to Writing
        </a>
        {
          (publishedAt || category) && (
            <p class="mt-10 text-xs text-muted">
              {publishedAt && <time datetime={isoDate(publishedAt)}>{formatDate(publishedAt)}</time>}
              {publishedAt && category && (
                <>
                  <span aria-hidden="true" class="mx-1.5">·</span>
                  <span class="sr-only">,</span>
                </>
              )}
              {category}
            </p>
          )
        }
        <h1
          class:list={[
            'max-w-[20ch] text-4xl leading-tight font-semibold tracking-tight sm:text-5xl',
            publishedAt || category ? 'mt-3' : 'mt-10',
          ]}
        >
          {title}
        </h1>
        {summary && <p class="mt-6 max-w-[65ch] text-lg leading-relaxed text-muted sm:text-xl">{summary}</p>}
      </div>
    </header>

    <div class:list={['pb-16 sm:pb-24', grid]}>
      <div class="article-body md:col-start-2">
        <slot />
      </div>
    </div>
  </article>

  <div class={container}>
    <div class:list={['border-t border-rule pt-12 pb-12 sm:pt-16', grid]}>
      <div class="md:col-start-2">
        <AuthorCard />
      </div>
    </div>
    <div class:list={['border-t border-rule pt-12 pb-16 sm:pb-24', grid]}>
      <div class="md:col-start-2">
        <MoreWriting slug={slug} />
      </div>
    </div>
  </div>
</PageLayout>

<style>
  /* Article typography. Text is capped at ~65 characters; figures and code blocks
     may run the full content column. */
  .article-body {
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .article-body :global(> *) {
    max-width: 65ch;
  }

  .article-body :global(> * + *) {
    margin-top: 1.5rem;
  }

  .article-body :global(> .article-figure),
  .article-body :global(> pre) {
    max-width: none;
  }

  .article-body :global(h2) {
    margin-top: 3rem;
    font-size: 1.625rem;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .article-body :global(h3) {
    margin-top: 2.25rem;
    font-size: 1.25rem;
    line-height: 1.35;
    font-weight: 600;
  }

  .article-body :global(h2 + *),
  .article-body :global(h3 + *) {
    margin-top: 0.75rem;
  }

  .article-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
    text-underline-offset: 4px;
  }

  .article-body :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 1.5rem;
  }

  .article-body :global(ul) {
    list-style: disc;
  }

  .article-body :global(ol) {
    list-style: decimal;
  }

  .article-body :global(li + li) {
    margin-top: 0.5rem;
  }

  .article-body :global(li::marker) {
    color: var(--color-muted);
  }

  .article-body :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    padding-left: 1.25rem;
    font-size: 1.25rem;
    line-height: 1.6;
  }

  .article-body :global(:not(pre) > code) {
    border: 1px solid var(--color-rule);
    padding: 0.1em 0.35em;
    font-size: 0.875em;
  }

  /* Code blocks keep the paper palette; long lines scroll inside the block. */
  .article-body :global(pre) {
    overflow-x: auto;
    border: 1px solid var(--color-rule);
    background-color: color-mix(in srgb, var(--color-ink) 4%, var(--color-paper)) !important;
    padding: 1.25rem 1.5rem;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .article-body :global(pre code),
  .article-body :global(pre span) {
    color: var(--color-ink) !important;
  }

  .article-body :global(code) {
    font-family: var(--font-sans);
  }

  .article-body :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-rule);
    margin-block: 3rem;
  }

  .article-body :global(> .article-figure) {
    margin-block: 2.5rem;
  }
</style>
