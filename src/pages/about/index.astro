---
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import HomeSection from '../../components/HomeSection.astro';
import LinkRow from '../../components/LinkRow.astro';
import AroundHereStickers from '../../components/AroundHereStickers.astro';
import stampsArtwork from '../../assets/about/stamps.png';
import { collections } from '../../data/home';
import { profiles } from '../../data/profiles';
import { routes } from '../../lib/routes';

// About-specific descriptions; routes come from the shared collection data, so a
// destination that doesn't exist renders as pending text rather than a link.
const aroundHere = [
  { slug: 'music', label: 'Music', description: 'Records, playlists and listening notes.' },
  { slug: 'books', label: 'Books', description: 'Reading notes and pages to return to.' },
  { slug: 'films', label: 'Films', description: 'A place for cinema and reflections.' },
  { slug: 'games', label: 'Games', description: 'Play, worlds and the ideas within them.' },
  { slug: 'travel', label: 'Travel', description: 'Places, observations and field notes.' },
  { slug: 'bookmarks', label: 'Bookmarks', description: 'Interesting corners of the internet.' },
].map((item) => ({
  ...item,
  href: collections.some(({ slug }) => slug === item.slug)
    ? routes.collection(item.slug)
    : undefined,
}));

const bioId = 'a-little-more-about-me';
const textLink =
  'text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent';
---

<PageLayout title="About — Tajdid Rahman" description="A little about Taj.">
  <div class="mx-auto max-w-[68rem] px-5 sm:px-8">
    <div class="opening pt-10 pb-14 sm:pt-16 sm:pb-20">
      <h1 class="font-bold tracking-[-0.045em]">Hey, I’m Taj.</h1>

      <div
        class="mt-10 grid gap-10 sm:mt-14 md:grid-cols-[minmax(0,3fr)_minmax(0,5fr)] md:gap-12"
      >
        <Image
          src={stampsArtwork}
          alt=""
          widths={[320, 480, 640]}
          width={640}
          sizes="(min-width: 48rem) 20rem, 16rem"
          loading="eager"
          class="h-auto w-full max-w-[16rem] md:max-w-[20rem]"
        />

        <div class="max-w-[38rem] text-lg leading-relaxed">
          <p>
            I’m a product designer from <span class="text-accent">Ireland</span>, currently living in <span class="text-accent">Dubai</span>. I’ve been making things for the internet since I was about 15.
          </p>
          <p class="mt-6">
            This is my little corner of it. A place for my <a href={routes.work} class={textLink}>work</a>, <a href={routes.writing} class={textLink}>writing</a>, things I’m building and whatever else I find interesting.
          </p>
          <p class="mt-10 text-sm">
            <a href={`#${bioId}`} class="text-accent hover:underline hover:underline-offset-4">
              Learn more about me below <span aria-hidden="true">↓</span>
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <HomeSection id={bioId} title="A little more about me">
    <!-- Keep each linked phrase on one line: Astro drops whitespace at line breaks next to tags. -->
    <div class="max-w-[38rem] space-y-6 text-lg leading-relaxed">
      <p>
        <em>Making things for the internet.</em> What started around the age of 15 has become a career in product design. I’m interested in how things work, how they feel to use, and the small decisions that make them clearer and more useful.
      </p>
      <p>
        Alongside my <a href={routes.work} class={textLink}>work</a>, this site gives me somewhere to share side projects, collect interesting things and leave room for ideas that might become something.
      </p>
      <p>
        My taste in <a href={routes.collection('music')} class={textLink}>music</a> wanders across genres. I’ve gathered a few playlists and some albums I keep coming back to. There’s also a shelf for <a href={routes.collection('books')} class={textLink}>books</a>, a place for <a href={routes.collection('films')} class={textLink}>films</a>, and another for <a href={routes.collection('games')} class={textLink}>games</a>—different ways to find a good story or get lost in a new world.
      </p>
      <p>
        <a href={routes.writing} class={textLink}>Writing</a> gives me a space to think things through. <a href={routes.collection('bookmarks')} class={textLink}>Bookmarks</a> is where I keep interesting corners of the internet within reach.
      </p>
      <p>
        I’d like this little corner to grow with me: part collection, part notebook, and always a work in progress.
      </p>
    </div>
  </HomeSection>

  <HomeSection id="around-here" title="Around here">
    <p class="text-xl sm:text-[1.375rem]">A few things, gathered in one place.</p>
    <!-- Dividers between rows only (no rule above the first or below the last). -->
    <ul class="mt-10 [&>li:first-child>*]:pt-0 [&>li:last-child]:border-b-0 [&>li:last-child>*]:pb-0">
      {aroundHere.map((item) => <LinkRow {...item} sticker={item.slug} />)}
    </ul>
    <AroundHereStickers placement="gutter" gutterHeading="around-here" />
  </HomeSection>

  <HomeSection id="elsewhere" title="Elsewhere">
    <ul class="[&>li:first-child>*]:pt-0 [&>li:last-child]:border-b-0 [&>li:last-child>*]:pb-0">
      {
        profiles.map(({ name, description, url }) => (
          <LinkRow
            label={name}
            description={description}
            href={url}
            arrow="↗"
            external
            rel="me"
            pendingLabel="Link to add"
          />
        ))
      }
    </ul>
  </HomeSection>
</PageLayout>

<style>
  /* The heading spans the content width at every size: font-size is tied to the
     container's inline size rather than to breakpoints. */
  .opening {
    container-type: inline-size;
  }

  h1 {
    /* The line measures ≈5.05em, so 19cqi fills ~96% of the width on one line. */
    font-size: 19cqi;
    line-height: 0.95;
  }
</style>
