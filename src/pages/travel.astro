---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import HomeSection from '../components/HomeSection.astro';
import { continentCounts, countries, snapshots, stats } from '../data/travel';
import { profiles } from '../data/profiles';

const instagram = profiles.find((profile) => profile.name === 'Instagram')?.url;
---

<PageLayout title="Travel — Tajdid Rahman" description="Places Taj has been, from trips further afield to somewhere closer to home.">
  <div class="mx-auto max-w-[68rem] px-5 sm:px-8">
    <div
      class="pt-14 pb-16 sm:pt-20 sm:pb-24 md:grid md:grid-cols-[11rem_minmax(0,1fr)] md:gap-x-12 md:pt-24"
    >
      <div class="md:col-start-2">
        <h1 class="text-5xl font-semibold tracking-tight sm:text-6xl">Travel</h1>
        <p class="mt-8 max-w-[38rem] text-lg leading-relaxed sm:text-xl">
          Places I’ve been, from trips further afield to somewhere closer to home.
        </p>

        <div class="mt-12 border-t border-rule pt-8">
          <dl class="flex flex-wrap items-end gap-x-14 gap-y-6">
            <div>
              <dt class="sr-only">Countries</dt>
              <dd class="text-6xl leading-none font-semibold tracking-tight sm:text-7xl">{stats.countries}</dd>
              <dd aria-hidden="true" class="mt-3 text-sm text-muted">countries</dd>
            </div>
            <div>
              <dt class="sr-only">Continents</dt>
              <dd class="text-6xl leading-none font-semibold tracking-tight sm:text-7xl">{stats.continents}</dd>
              <dd aria-hidden="true" class="mt-3 text-sm text-muted">continents</dd>
            </div>
            <div>
              <dt class="sr-only">Cities, regions and islands</dt>
              <dd class="text-6xl leading-none font-semibold tracking-tight sm:text-7xl">{stats.places}</dd>
              <dd aria-hidden="true" class="mt-3 text-sm text-muted">cities, regions &amp; islands</dd>
            </div>
          </dl>
          <p class="mt-6 text-[0.9375rem]">
            {
              continentCounts.map(([continent, count], index) => (
                <>
                  {index > 0 && <span aria-hidden="true" class="mx-2 text-rule">/</span>}
                  <span class="whitespace-nowrap">
                    {continent} <span class="text-muted">{count}</span>
                  </span>
                </>
              ))
            }
          </p>
          <p class="mt-3 text-xs text-muted">An ongoing collection, still being filled in.</p>
        </div>
      </div>
    </div>
  </div>

  {
    snapshots.length > 0 && (
      <HomeSection id="snapshots" title="Snapshots">
        <ul class="grid gap-6 sm:grid-cols-2 sm:gap-8">
          {snapshots.map((d) => (
            <li>
              <figure>
                <Image
                  src={d.image!.src}
                  alt={d.image!.alt}
                  widths={[480, 720, 960]}
                  width={960}
                  sizes="(min-width: 68rem) 25rem, (min-width: 40rem) 45vw, 100vw"
                  class="aspect-[4/3] w-full rounded-sm border border-rule object-cover"
                />
                <figcaption class="mt-3 flex items-baseline gap-2 text-[0.9375rem]">
                  <span aria-hidden="true">{d.country.flag}</span>
                  <span>
                    {d.name}<span class="text-muted">, {d.country.name}</span>
                  </span>
                </figcaption>
                {d.caption && <p class="mt-1 text-sm text-muted">{d.caption}</p>}
              </figure>
            </li>
          ))}
        </ul>
        {instagram && (
          <p class="mt-8 text-[0.9375rem]">
            <a href={instagram} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline hover:underline-offset-4">
              More travel shots on Instagram <span aria-hidden="true">↗</span><span class="sr-only">{' (opens in a new tab)'}</span>
            </a>
          </p>
        )}
      </HomeSection>
    )
  }

  <HomeSection id="places-ive-been" title="Places I’ve been">
    <!-- No rule above the first row (1, 2 or 3 blocks depending on the column count). -->
    <div class="grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3 [&>section:first-child]:border-t-0 [&>section:first-child]:pt-0 sm:[&>section:nth-child(-n+2)]:border-t-0 sm:[&>section:nth-child(-n+2)]:pt-0 lg:[&>section:nth-child(-n+3)]:border-t-0 lg:[&>section:nth-child(-n+3)]:pt-0">
      {
        countries.map((country) => (
          <section aria-labelledby={`country-${country.id}`} class="border-t border-rule pt-4 pb-7">
            <h3 id={`country-${country.id}`} class="flex items-center gap-3 text-lg leading-snug">
              <span aria-hidden="true" class="text-2xl leading-none">{country.flag}</span>
              <span>{country.name}</span>
            </h3>
            {country.destinations.length > 0 ? (
              <ul class="mt-3 space-y-1.5 pl-[2.375rem] text-[0.9375rem]">
                {country.destinations.map((d) => (
                  <li class="text-ink/85">
                    {d.name}
                    {d.home && (
                      <span class="ml-2 rounded-full border border-accent/30 px-1.5 py-px text-[0.6875rem] text-accent">Home</span>
                    )}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-3 pl-[2.375rem] text-sm text-muted">Places to be added</p>
            )}
          </section>
        ))
      }
    </div>
  </HomeSection>
</PageLayout>
