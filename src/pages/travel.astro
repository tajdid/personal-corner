---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import HomeSection from '../components/HomeSection.astro';
import { countries, stats } from '../data/travel';
---

<PageLayout title="Travel — Tajdid Rahman" description="Places Taj has been, from trips further afield to somewhere closer to home.">
  <div class="mx-auto max-w-[68rem] px-5 sm:px-8">
    <div
      class="pt-14 pb-16 sm:pt-20 sm:pb-24 md:grid md:grid-cols-[11rem_minmax(0,1fr)] md:gap-x-12 md:pt-24"
    >
      <div class="md:col-start-2">
        <h1 class="text-5xl font-semibold tracking-tight sm:text-6xl">Travel</h1>
        <p class="mt-8 max-w-[38rem] text-lg leading-relaxed sm:text-xl">
          Places I’ve been, from trips further afield to somewhere closer to home.
        </p>
        <dl class="mt-10 flex gap-12">
          <div>
            <dt class="sr-only">Countries</dt>
            <dd class="text-4xl font-semibold tracking-tight sm:text-5xl">{stats.countries}</dd>
            <dd aria-hidden="true" class="mt-1 text-sm text-muted">countries</dd>
          </div>
          <div>
            <dt class="sr-only">Continents</dt>
            <dd class="text-4xl font-semibold tracking-tight sm:text-5xl">{stats.continents}</dd>
            <dd aria-hidden="true" class="mt-1 text-sm text-muted">continents</dd>
          </div>
        </dl>
        <p class="mt-6 text-xs text-muted">An ongoing collection, still being filled in.</p>
      </div>
    </div>
  </div>

  <HomeSection id="places-ive-been" title="Places I’ve been">
    <!-- One row per country: name and flag on the left, destinations on the right. -->
    <div>
      {
        countries.map((country) => {
          const withPhotos = country.destinations.filter((d) => d.image);
          const textOnly = country.destinations.filter((d) => !d.image);
          return (
            <section
              aria-labelledby={`country-${country.id}`}
              class="border-t border-rule py-5 first:border-t-0 first:pt-0 last:pb-0 sm:grid sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-x-6 sm:py-6"
            >
              <h3 id={`country-${country.id}`} class="flex items-baseline gap-2.5 text-[0.9375rem]">
                <span aria-hidden="true" class="text-base leading-none">{country.flag}</span>
                <span>{country.name}</span>
              </h3>

              <div class="mt-3 sm:mt-0">
                {withPhotos.length > 0 && (
                  <ul class="mb-4 grid grid-cols-2 gap-4 sm:grid-cols-3">
                    {withPhotos.map((d) => (
                      <li>
                        <figure>
                          <Image
                            src={d.image!.src}
                            alt={d.image!.alt}
                            widths={[320, 480, 640]}
                            width={640}
                            sizes="(min-width: 68rem) 15rem, (min-width: 40rem) 28vw, 45vw"
                            class="aspect-[3/2] w-full rounded-sm border border-rule object-cover"
                          />
                          <figcaption class="mt-2 text-[0.9375rem]">
                            {d.name}
                            {d.home && <span class="ml-2 text-xs text-accent">Home</span>}
                            {d.caption && <span class="mt-1 block text-sm text-muted">{d.caption}</span>}
                          </figcaption>
                        </figure>
                      </li>
                    ))}
                  </ul>
                )}

                {textOnly.length > 0 ? (
                  <ul class="grid grid-cols-2 gap-x-6 gap-y-2 min-[50rem]:grid-cols-3">
                    {textOnly.map((d) => (
                      <li class="flex items-baseline gap-2 text-[0.9375rem]">
                        <svg aria-hidden="true" viewBox="0 0 12 16" class="h-3 w-2.5 shrink-0 translate-y-px fill-none stroke-muted" stroke-width="1.5">
                          <path d="M6 15s5-5.2 5-8.8A5 5 0 0 0 1 6.2C1 9.8 6 15 6 15Z" />
                          <circle cx="6" cy="6.2" r="1.7" />
                        </svg>
                        <span>
                          {d.name}
                          {d.home && <span class="ml-2 text-xs text-accent">Home</span>}
                          {d.caption && <span class="block text-sm text-muted">{d.caption}</span>}
                        </span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  withPhotos.length === 0 && <p class="text-sm text-muted">Places to be added</p>
                )}
              </div>
            </section>
          );
        })
      }
    </div>
  </HomeSection>
</PageLayout>
