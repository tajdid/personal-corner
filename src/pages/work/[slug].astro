---
import type { GetStaticPaths } from 'astro';
import PlaceholderPage from '../../layouts/PlaceholderPage.astro';
import { projects } from '../../data/home';
import { routes } from '../../lib/routes';

export const getStaticPaths = (() =>
  projects.map(({ slug, title }) => ({ params: { slug }, props: { title } }))) satisfies GetStaticPaths;

const { title } = Astro.props;
---

<PlaceholderPage
  title={title}
  message="The project write-up is coming later."
  back={{ label: 'All work', href: routes.work }}
/>
