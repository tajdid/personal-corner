---
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import HomeSection from '../../components/HomeSection.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import { projects } from '../../data/projects';
import { routes } from '../../lib/routes';

export const getStaticPaths = (() =>
  projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;

const { project } = Astro.props;
const { title, headline, summary, role, year, scope, collaborators, leadImage, story } = project;

// Only metadata that exists is rendered, so incomplete entries leave no empty labels.
const meta = [
  { label: 'Role', value: role },
  { label: 'Year', value: year?.toString() },
  { label: 'Scope', value: scope },
  { label: 'Collaborators', value: collaborators?.join(', ') },
].filter((item): item is { label: string; value: string } => Boolean(item.value));

const slugify = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const backLink = 'text-sm text-accent hover:underline hover:underline-offset-4';
const container = 'mx-auto max-w-[68rem] px-5 sm:px-8';
const grid = 'md:grid md:grid-cols-[11rem_minmax(0,1fr)] md:gap-x-12';
---

<PageLayout title={`${headline ?? title} — Tajdid Rahman`} description={summary}>
  <div class={container}>
    <div class:list={['pt-10 pb-12 sm:pt-14 sm:pb-16', grid]}>
      <div class="md:col-start-2">
        <a href={routes.work} class={backLink}>
          <span aria-hidden="true">←</span> Back to Work
        </a>
        {headline && <p class="mt-10 text-sm text-muted">{title}</p>}
        <h1
          class:list={[
            'font-semibold tracking-tight',
            headline ? 'mt-3 text-4xl leading-tight sm:text-5xl' : 'mt-10 text-5xl sm:text-6xl',
          ]}
        >
          {headline ?? title}
        </h1>
        <p class="mt-6 max-w-[38rem] text-lg leading-relaxed sm:text-xl">{summary}</p>

        {
          meta.length > 0 && (
            <dl class="mt-10 grid grid-cols-2 gap-x-8 gap-y-5 border-t border-rule pt-5 sm:grid-cols-4">
              {meta.map(({ label, value }) => (
                <div>
                  <dt class="text-xs text-muted">{label}</dt>
                  <dd class="mt-1 text-[0.9375rem]">{value}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </div>

    {
      leadImage && (
        <div class="pb-16 sm:pb-24">
          <ProjectMedia
            image={leadImage}
            aspect="aspect-[16/9]"
            sizes="(min-width: 68rem) 64rem, 100vw"
            priority
          />
        </div>
      )
    }
  </div>

  {
    story?.map((block) =>
      block.kind === 'text' ? (
        <HomeSection id={slugify(block.heading)} title={block.heading}>
          <div class="max-w-[38rem] space-y-5">
            {block.placeholder && <p class="text-xs text-muted">Placeholder copy</p>}
            {block.paragraphs.map((paragraph) => (
              <p class="text-lg leading-relaxed">{paragraph}</p>
            ))}
          </div>
        </HomeSection>
      ) : (
        <figure class:list={[container, 'pb-16 sm:pb-24']}>
          {block.kind === 'image' ? (
            <ProjectMedia image={block.image} aspect="aspect-[16/9]" sizes="(min-width: 68rem) 64rem, 100vw" />
          ) : (
            <div class="grid gap-5 sm:grid-cols-2 sm:gap-7">
              {block.images.map((image) => (
                <ProjectMedia image={image} aspect="aspect-[4/3]" sizes="(min-width: 68rem) 31rem, (min-width: 40rem) 50vw, 100vw" />
              ))}
            </div>
          )}
          {block.caption && <figcaption class="mt-3 text-xs text-muted">{block.caption}</figcaption>}
        </figure>
      ),
    )
  }

  {
    !story?.length && (
      <div class={container}>
        <div class:list={['border-t border-rule pt-8 pb-16 sm:pt-11 sm:pb-24', grid]}>
          <p class="text-lg text-muted md:col-start-2">The full write-up is coming later.</p>
        </div>
      </div>
    )
  }

  <div class={container}>
    <div class:list={['border-t border-rule py-10 sm:py-12', grid]}>
      <p class="md:col-start-2">
        <a href={routes.work} class={backLink}>
          <span aria-hidden="true">←</span> All work
        </a>
      </p>
    </div>
  </div>
</PageLayout>
