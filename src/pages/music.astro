---
import PageLayout from '../layouts/PageLayout.astro';
import HomeSection from '../components/HomeSection.astro';
import SquareArtwork from '../components/music/SquareArtwork.astro';
import { playlists, albums } from '../data/music';

const linkClass = 'text-accent hover:underline hover:underline-offset-4';
---

<PageLayout title="Music — Tajdid Rahman" description="A few playlists and six albums Taj keeps coming back to.">
  <div class="mx-auto max-w-[68rem] px-5 sm:px-8">
    <div
      class="pt-14 pb-16 sm:pt-20 sm:pb-24 md:grid md:grid-cols-[11rem_minmax(0,1fr)] md:gap-x-12 md:pt-24"
    >
      <div class="md:col-start-2">
        <h1 class="text-5xl font-semibold tracking-tight sm:text-6xl">Music</h1>
        <p class="mt-8 max-w-[38rem] text-lg leading-relaxed sm:text-xl">
          My taste wanders across genres. Here are a few playlists I’ve put together and six albums I keep coming back to.
        </p>
      </div>
    </div>
  </div>

  <HomeSection id="playlists" title="Playlists">
    <ul class="grid gap-12 sm:grid-cols-3 sm:gap-8">
      {
        playlists.map(({ title, description, artwork, url }) => (
          <li>
            <SquareArtwork
              artwork={artwork}
              label={`${title} — cover`}
              sizes="(min-width: 68rem) 15rem, (min-width: 40rem) 30vw, 22rem"
              class="max-w-[22rem] sm:max-w-none"
            />
            <h3 class="mt-4 text-lg leading-snug">{title}</h3>
            <p class="mt-1.5 text-[0.9375rem] text-muted">{description}</p>
            {url && (
              <p class="mt-3 text-[0.9375rem]">
                <a href={url} target="_blank" rel="noopener noreferrer" class={linkClass}>
                  Listen on Spotify<span class="sr-only">{`: ${title} (opens in a new tab)`}</span>{' '}
                  <span aria-hidden="true">↗</span>
                </a>
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </HomeSection>

  <HomeSection id="albums-i-return-to" title="Albums I return to">
    <ul class="grid grid-cols-2 gap-x-5 gap-y-10 sm:grid-cols-3 sm:gap-x-8 sm:gap-y-14">
      {
        albums.map(({ title, artist, artwork, url }) => (
          <li class="group relative">
            <SquareArtwork
              artwork={artwork}
              label={`${title} — cover`}
              sizes="(min-width: 68rem) 15rem, (min-width: 40rem) 30vw, 45vw"
              class="transition-colors group-hover:border-muted"
            />
            <h3 class="mt-3 text-base leading-snug sm:text-lg">
              {url ? (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="stretched-link text-accent underline-offset-4 group-hover:underline"
                >
                  {title}
                  <span class="sr-only">{` by ${artist} on Spotify (opens in a new tab)`}</span>
                </a>
              ) : (
                title
              )}
            </h3>
            <p class="mt-1 text-[0.9375rem] text-muted" aria-hidden={url ? 'true' : undefined}>
              {artist}
            </p>
          </li>
        ))
      }
    </ul>
  </HomeSection>
</PageLayout>
