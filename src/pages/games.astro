---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import HomeSection from '../components/HomeSection.astro';
import GameCover from '../components/games/GameCover.astro';
import { BACKLOGGD_URL, collectionByPlatform, consoleFamilies, currentlyPlaying } from '../data/games';

const linkClass = 'text-accent hover:underline hover:underline-offset-4';
const newTab = { target: '_blank', rel: 'noopener noreferrer' };

const slug = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, '-');
/** "September 2022" */
const formatMonth = (yearMonth: string) =>
  new Date(`${yearMonth}-01T00:00:00Z`).toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<PageLayout title="Games — Tajdid Rahman" description="Games Taj is playing, has played, and the consoles along the way.">
  <div class="mx-auto max-w-[68rem] px-5 sm:px-8">
    <div
      class="pt-14 pb-16 sm:pt-20 sm:pb-24 md:grid md:grid-cols-[11rem_minmax(0,1fr)] md:gap-x-12 md:pt-24"
    >
      <div class="md:col-start-2">
        <h1 class="text-5xl font-semibold tracking-tight sm:text-6xl">Games</h1>
        <p class="mt-8 max-w-[38rem] text-lg leading-relaxed sm:text-xl">
          From Pokémon on a handheld to getting lost in something on the big screen. These days I mostly play on Switch 2 and PS5, with a collection that stretches back to the Game Boy.
        </p>
        <p class="mt-6 text-[0.9375rem]">
          <a href={BACKLOGGD_URL} {...newTab} class={linkClass}>
            Find me on Backloggd <span aria-hidden="true">↗</span><span class="sr-only">{' (opens in a new tab)'}</span>
          </a>
        </p>
      </div>
    </div>
  </div>

  <HomeSection id="currently-playing" title="Currently playing">
    <ul class="space-y-4 sm:space-y-5">
      {
        currentlyPlaying.map((game) => (
          <li class="relative isolate overflow-hidden rounded-3xl bg-ink text-paper sm:rounded-[2rem]">
            {game.artwork && (
              <Image
                src={game.artwork.src}
                alt=""
                width={240}
                class="game-backdrop absolute inset-0 -z-10 size-full object-cover"
              />
            )}
            <div aria-hidden="true" class="game-scrim absolute inset-0 -z-10" />
            <div class="flex items-center gap-5 p-4 sm:gap-8 sm:p-6">
              {game.artwork && (
                <Image
                  src={game.artwork.src}
                  alt=""
                  widths={[160, 240, 320]}
                  width={Math.min(320, game.artwork.src.width)}
                  sizes="(min-width: 40rem) 7rem, 5rem"
                  class="aspect-[3/4] w-20 shrink-0 rounded-md object-cover shadow-lg sm:w-28"
                />
              )}
              <div class="min-w-0">
                <h3 class="text-xl leading-snug sm:text-2xl">
                  {game.url ? (
                    <a href={game.url} {...newTab} class="text-paper underline-offset-4 hover:underline">
                      {game.title}
                      <span class="sr-only">{' (opens in a new tab)'}</span>
                    </a>
                  ) : (
                    game.title
                  )}
                </h3>
                <dl class="mt-4 grid gap-x-12 gap-y-3 min-[30rem]:grid-cols-[auto_auto] min-[30rem]:justify-start sm:mt-5">
                  {game.playingOn && (
                    <div>
                      <dt class="text-xs text-paper/70 sm:text-sm">Console</dt>
                      <dd class="mt-0.5 sm:mt-1 sm:text-lg">{game.playingOn}</dd>
                    </div>
                  )}
                  {game.released && (
                    <div>
                      <dt class="text-xs text-paper/70 sm:text-sm">Released</dt>
                      <dd class="mt-0.5 sm:mt-1 sm:text-lg">
                        <time datetime={game.released}>{formatMonth(game.released)}</time>
                      </dd>
                    </div>
                  )}
                </dl>
                {game.note && <p class="mt-4 leading-relaxed text-paper/85">{game.note}</p>}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </HomeSection>

  <HomeSection id="from-my-collection" title="From my collection">
    <!-- One row per console: name on the left, up to four same-size covers on the right. -->
    <div class="[&>section:first-child]:border-t-0 [&>section:first-child]:pt-0">
      {
        collectionByPlatform.map(({ platform, games }) => (
          <section
            aria-labelledby={`platform-${slug(platform)}`}
            class="border-t border-rule py-6 first:pt-0 last:pb-0 sm:grid sm:grid-cols-[8.5rem_minmax(0,1fr)] sm:gap-x-6 sm:py-8"
          >
            <h3 id={`platform-${slug(platform)}`} class="text-[0.9375rem] sm:pt-1">
              {platform}
            </h3>
            <ul class="mt-4 grid grid-cols-3 gap-3 min-[30rem]:grid-cols-4 sm:mt-0 sm:gap-5">
              {games.map((game) => (
                <li>
                  {game.url ? (
                    <a href={game.url} {...newTab} class="block rounded-sm">
                      <GameCover artwork={game.artwork} label={game.title} sizes="(min-width: 68rem) 9rem, (min-width: 30rem) 22vw, 30vw" aspect="tile" decorative={false} />
                      <span class="sr-only">{' (opens in a new tab)'}</span>
                    </a>
                  ) : (
                    <GameCover artwork={game.artwork} label={game.title} sizes="(min-width: 68rem) 9rem, (min-width: 30rem) 22vw, 30vw" aspect="tile" decorative={false} />
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </HomeSection>

  <HomeSection id="the-consoles" title="The consoles">
    <div class="grid gap-x-10 gap-y-10 sm:grid-cols-3">
      {
        consoleFamilies.map((family) => (
          <div>
            <h3 class="text-xs text-muted">{family.name}</h3>
            <ul class="mt-3 space-y-2">
              {family.consoles.map((item) => (
                <li class="flex flex-wrap items-baseline gap-x-2">
                  <span class={item.current ? 'text-accent' : undefined}>{item.name}</span>
                  {item.current && <span class="text-xs text-muted">Currently using</span>}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </HomeSection>
</PageLayout>

<style>
  /* The cover itself, heavily blurred, as the card's background. */
  .game-backdrop {
    filter: blur(28px) saturate(1.15);
    transform: scale(1.25);
  }

  .game-scrim {
    background: linear-gradient(to right, rgb(10 12 10 / 0.55), rgb(10 12 10 / 0.3) 60%, rgb(10 12 10 / 0.15));
  }
</style>
