---
import PageLayout from '../layouts/PageLayout.astro';
import HomeSection from '../components/HomeSection.astro';
import BookCover from '../components/books/BookCover.astro';
import { books, isSampleSelection } from '../data/books';
---

<PageLayout title="Books — Tajdid Rahman" description="A few books on product, design and business.">
  <div class="mx-auto max-w-[68rem] px-5 sm:px-8">
    <div
      class="pt-14 pb-16 sm:pt-20 sm:pb-24 md:grid md:grid-cols-[11rem_minmax(0,1fr)] md:gap-x-12 md:pt-24"
    >
      <div class="md:col-start-2">
        <h1 class="text-5xl font-semibold tracking-tight sm:text-6xl">Books</h1>
        <p class="mt-8 max-w-[38rem] text-lg leading-relaxed sm:text-xl">
          A few books on product, design and business.
        </p>
        {
          isSampleSelection && (
            <p class="mt-4 text-xs text-muted">Sample selection — personal recommendations coming soon.</p>
          )
        }
      </div>
    </div>
  </div>

  <HomeSection id="selection" title="Selection">
    <ul class="grid grid-cols-2 gap-x-5 gap-y-10 sm:grid-cols-3 sm:gap-x-8 sm:gap-y-14">
      {
        books.map(({ title, author, cover, note, url }) => (
          <li class:list={['relative', url && 'group']}>
            <BookCover
              cover={cover}
              label={`${title} — cover`}
              sizes="(min-width: 68rem) 15rem, (min-width: 40rem) 30vw, 45vw"
            />
            <h3 class="mt-3 text-base leading-snug sm:text-lg">
              {url ? (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="stretched-link text-accent underline-offset-4 group-hover:underline"
                >
                  {title}
                  <span class="sr-only">{` by ${author} (opens in a new tab)`}</span>
                </a>
              ) : (
                title
              )}
            </h3>
            <p class="mt-1 text-[0.9375rem] text-muted" aria-hidden={url ? 'true' : undefined}>
              {author}
            </p>
            {note && <p class="mt-2 text-[0.9375rem] leading-relaxed">{note}</p>}
          </li>
        ))
      }
    </ul>
  </HomeSection>
</PageLayout>
