---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<!-- Foundation placeholder. The approved homepage (docs/DESIGN.md) replaces this in Milestone 03. -->
<BaseLayout>
  <main class="mx-auto max-w-[45rem] px-6 py-24 sm:py-32">
    <h1 class="text-5xl font-semibold tracking-tight sm:text-6xl">Hey, I'm Taj.</h1>
    <p class="mt-8 text-lg leading-relaxed">
      I'm a product designer from Ireland, currently living in Dubai. I've been making things for
      the internet since I was about 15.
    </p>
    <p class="mt-6 text-lg leading-relaxed">
      This is my little corner of it. A place for my work, writing, things I'm building and
      whatever else I find interesting.
    </p>
    <p class="mt-12 border-t border-rule pt-4 text-sm text-muted">
      Placeholder — the full homepage is still being built.
    </p>
  </main>
</BaseLayout>
