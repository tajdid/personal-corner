---
import PageLayout from '../layouts/PageLayout.astro';
import HomeSection from '../components/HomeSection.astro';
import ProjectRow from '../components/ProjectRow.astro';
import WritingRow from '../components/WritingRow.astro';
import CollectionLink from '../components/CollectionLink.astro';
import LifeLatelyItem from '../components/LifeLatelyItem.astro';
import { projects, writing, lifeLately, collections } from '../data/home';
import { routes } from '../lib/routes';

// Formats a YYYY-MM snapshot as e.g. "October 2026" (fixed, not clock-based).
const formatMonth = (yearMonth: string) =>
  new Date(`${yearMonth}-01T00:00:00Z`).toLocaleDateString('en-GB', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });

const textLink =
  'text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent';
---

<PageLayout>
  <div class="mx-auto max-w-[68rem] px-5 sm:px-8">
    <div
      class="pt-14 pb-16 sm:pt-20 sm:pb-24 md:grid md:grid-cols-[11rem_minmax(0,1fr)] md:gap-x-12 md:pt-24"
    >
      <div class="md:col-start-2">
        <p class="text-xs tracking-wide text-muted uppercase">
          Northern Ireland <span aria-hidden="true">→</span><span class="sr-only">to</span> Dubai
        </p>
        <h1 class="mt-6 text-5xl font-semibold tracking-tight sm:text-6xl">Hey, I'm Taj.</h1>
        <div class="mt-8 max-w-[47rem] space-y-6 text-lg leading-relaxed sm:text-xl">
          <p>
            I'm a product designer from Ireland, currently living in Dubai. I've been making
            things for the internet since I was about 15.
          </p>
          <p>
            <!-- Keep the linked phrase on one line: Astro drops whitespace at line breaks next to tags. -->
            This is my little corner of it.
            A place for my <a href={routes.work} class={textLink}>work</a>, <a href={routes.writing} class={textLink}>writing</a>, things I'm building and whatever else I find interesting.
          </p>
        </div>
        <p class="mt-8 text-xs text-muted">A designer, a curious person, a work in progress.</p>
      </div>
    </div>
  </div>

  <HomeSection id="things-ive-made" number="01" title="Things I've made" note="A few things out in the world.">
    <div class="space-y-12 sm:space-y-10">
      {projects.map((project) => <ProjectRow {...project} />)}
    </div>
  </HomeSection>

  <HomeSection id="notes-from-the-internet" number="02" title="Notes from the internet">
    <div>
      {writing.map((entry) => <WritingRow {...entry} />)}
    </div>
    <p class="mt-6 text-sm">
      <a href={routes.writing} class="text-accent hover:underline hover:underline-offset-4">
        All writing <span aria-hidden="true">→</span>
      </a>
    </p>
  </HomeSection>

  <HomeSection id="life-lately" number="03" title="Life lately">
    <time slot="note" datetime={lifeLately.asOf}>{formatMonth(lifeLately.asOf)}</time>
    <div class="grid gap-y-12 sm:grid-cols-3 sm:gap-x-8">
      {lifeLately.entries.map((entry) => <LifeLatelyItem {...entry} />)}
    </div>
  </HomeSection>

  <HomeSection id="around-here" number="04" title="Around here">
    <p class="text-lg">A few shelves for the things I keep coming back to.</p>
    <div class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2">
      {collections.map((collection) => <CollectionLink {...collection} />)}
    </div>
  </HomeSection>
</PageLayout>
