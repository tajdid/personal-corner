---
import PageLayout from '../../layouts/PageLayout.astro';
import WritingRow from '../../components/WritingRow.astro';
import { getArticles } from '../../lib/articles';
---

<PageLayout title="Writing — Tajdid Rahman" description="Notes and essays by Taj.">
  <div class="mx-auto max-w-[68rem] px-5 sm:px-8">
    <div
      class="pt-14 pb-12 sm:pt-20 sm:pb-16 md:grid md:grid-cols-[11rem_minmax(0,1fr)] md:gap-x-12 md:pt-24"
    >
      <div class="md:col-start-2">
        <h1 class="text-5xl font-semibold tracking-tight sm:text-6xl">Writing</h1>
        <p class="mt-8 max-w-[38rem] text-lg leading-relaxed sm:text-xl">
          Notes on design, films, games and the things that catch my attention.
        </p>
      </div>
    </div>

    <section aria-label="Articles" class="pb-20 sm:pb-28 md:grid md:grid-cols-[11rem_minmax(0,1fr)] md:gap-x-12">
      <!-- Dividers between articles only: the last row drops its rule and bottom padding. -->
      <div class="md:col-start-2 [&>article:last-child]:border-b-0 [&>article:last-child]:pb-0 [&>article]:py-7 [&>article:first-child]:pt-0">
        {getArticles().map((article) => <WritingRow {...article} headingLevel="h2" />)}
      </div>
    </section>
  </div>
</PageLayout>
