---
import type { GetStaticPaths } from 'astro';
import PlaceholderPage from '../layouts/PlaceholderPage.astro';
import { collections } from '../data/home';

// Placeholder pages for collections without their own page yet (/books, /films, …).
export const getStaticPaths = (() => {
  // Collections with a dedicated page in src/pages are skipped to avoid a route clash.
  // (Defined here: getStaticPaths can't read other frontmatter variables.)
  const dedicatedPages = new Set(['music', 'books', 'films']);
  return collections
    .filter(({ slug }) => !dedicatedPages.has(slug))
    .map(({ slug, label }) => ({ params: { collection: slug }, props: { label } }));
}) satisfies GetStaticPaths;

const { label } = Astro.props;
---

<PlaceholderPage title={label} message="This collection is coming later." />
