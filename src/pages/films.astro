---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import HomeSection from '../components/HomeSection.astro';
import {
  PROFILE_URL,
  backdropFor,
  creditLabel,
  formatRuntime,
  formatWatched,
  getFilms,
  posterFor,
} from '../lib/films';

const films = getFilms();
const featured = films?.featured;
const details = featured?.details;
const backdrop = backdropFor(details?.backdrop);
const featuredPoster = posterFor(featured?.poster);
const recent = (films?.recent ?? []).filter((entry) => entry.slug !== featured?.slug).slice(0, 16);

const linkClass = 'text-accent hover:underline hover:underline-offset-4';
const newTab = { target: '_blank', rel: 'noopener noreferrer' };
---

<PageLayout title="Films — Tajdid Rahman" description="A little record of what Taj has been watching.">
  <div class="mx-auto max-w-[68rem] px-5 sm:px-8">
    <div
      class="pt-14 pb-12 sm:pt-20 sm:pb-16 md:grid md:grid-cols-[11rem_minmax(0,1fr)] md:gap-x-12 md:pt-24"
    >
      <div class="md:col-start-2">
        <h1 class="text-5xl font-semibold tracking-tight sm:text-6xl">Films</h1>
        <p class="mt-8 max-w-[38rem] text-lg leading-relaxed sm:text-xl">
          A little record of what I’ve been watching. Here’s the last film I saw, and a few more from my recent Letterboxd diary.
        </p>
        <p class="mt-6 text-[0.9375rem]">
          <a href={PROFILE_URL} {...newTab} class={linkClass}>
            Find me on Letterboxd <span aria-hidden="true">↗</span><span class="sr-only">{' (opens in a new tab)'}</span>
          </a>
        </p>
      </div>
    </div>
  </div>

  {
    featured ? (
      <>
        {/* Wider than the editorial container on large screens, with bounded gutters. */}
        <section aria-labelledby="last-watched" class="mx-auto max-w-[80rem] px-3 sm:px-5 lg:px-6">
          <div class="relative isolate flex min-h-[34rem] items-end overflow-hidden rounded-md bg-ink text-paper sm:min-h-[36rem] lg:min-h-[40rem]">
            {backdrop && (
              <Image
                src={backdrop}
                alt=""
                widths={[640, 960, 1280, 1920]}
                width={Math.min(1920, backdrop.width)}
                sizes="(min-width: 80rem) 78rem, 100vw"
                priority
                class="absolute inset-0 -z-10 size-full object-cover"
              />
            )}
            <div aria-hidden="true" class="film-scrim absolute inset-0 -z-10" />

            <div class="w-full px-5 pt-40 pb-8 sm:px-10 sm:pb-10 lg:px-14 lg:pb-14">
              <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:gap-8">
                {featuredPoster && (
                  <Image
                    src={featuredPoster}
                    alt=""
                    widths={[160, 240, 320, 400]}
                    width={Math.min(400, featuredPoster.width)}
                    sizes="(min-width: 64rem) 12rem, (min-width: 40rem) 9rem, 7rem"
                    class="aspect-[2/3] w-28 shrink-0 rounded-sm object-cover ring-1 ring-white/15 sm:w-36 lg:w-48"
                  />
                )}
                <div class="min-w-0 max-w-[40rem]">
                  <p class="text-xs tracking-wide text-paper/75 uppercase">
                    <span id="last-watched">Last watched</span>
                    {featured.watchedDate && (
                      <>
                        <span aria-hidden="true" class="mx-1.5">·</span>
                        <time datetime={featured.watchedDate}>{formatWatched(featured.watchedDate)}</time>
                      </>
                    )}
                    {featured.rewatch && (
                      <>
                        <span aria-hidden="true" class="mx-1.5">·</span>
                        Rewatch
                      </>
                    )}
                  </p>
                  <h2 class="mt-3 text-4xl leading-tight font-semibold tracking-tight sm:text-5xl">
                    {featured.title}
                  </h2>
                  {featured.synopsis && (
                    <p class="mt-4 text-base leading-relaxed text-paper/85 sm:text-lg">{featured.synopsis}</p>
                  )}

                  <dl class="mt-6 grid grid-cols-2 gap-x-8 gap-y-4 text-[0.9375rem] sm:flex sm:flex-wrap sm:gap-x-10">
                    {details?.directors?.length ? (
                      <div class="col-span-2 sm:col-span-1">
                        <dt class="text-xs text-paper/65">{creditLabel(details.directors, details.writers ?? [])}</dt>
                        <dd class="mt-1">{details.directors.join(', ')}</dd>
                      </div>
                    ) : null}
                    {featured.year && (
                      <div>
                        <dt class="text-xs text-paper/65">Year</dt>
                        <dd class="mt-1">{featured.year}</dd>
                      </div>
                    )}
                    {details?.runtime && (
                      <div>
                        <dt class="text-xs text-paper/65">Duration</dt>
                        <dd class="mt-1">{formatRuntime(details.runtime)}</dd>
                      </div>
                    )}
                  </dl>

                  <ul class="mt-7 flex flex-wrap gap-x-8 gap-y-3 text-[0.9375rem]">
                    {details?.trailer && (
                      <li>
                        <a href={details.trailer.url} {...newTab} class="film-link">
                          Watch trailer <span aria-hidden="true">↗</span>
                          <span class="sr-only">{` for ${featured.title} on YouTube (opens in a new tab)`}</span>
                        </a>
                      </li>
                    )}
                    <li>
                      <a href={featured.entryUrl} {...newTab} class="film-link">
                        View on Letterboxd <span aria-hidden="true">↗</span>
                        <span class="sr-only">{` — my diary entry for ${featured.title} (opens in a new tab)`}</span>
                      </a>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </section>

        <div class="mt-16 sm:mt-24">
          <HomeSection id="recently-watched" title="Recently watched">
            {recent.length > 0 ? (
              <ul class="grid grid-cols-2 gap-5 sm:grid-cols-4 sm:gap-8">
                {recent.map((entry) => {
                  const poster = posterFor(entry.poster);
                  return (
                    <li>
                      <a href={entry.entryUrl} {...newTab} class="group block rounded-sm">
                        {poster ? (
                          <Image
                            src={poster}
                            alt=""
                            widths={[200, 300, 400]}
                            width={Math.min(400, poster.width)}
                            sizes="(min-width: 68rem) 11rem, (min-width: 40rem) 22vw, 45vw"
                            class="aspect-[2/3] w-full rounded-sm border border-rule object-cover transition-colors group-hover:border-muted"
                          />
                        ) : (
                          <span class="flex aspect-[2/3] w-full items-center justify-center rounded-sm border border-rule p-2 text-center text-xs text-muted">
                            {entry.title}
                          </span>
                        )}
                        <span class="sr-only">
                          {`${entry.title}${entry.year ? ` (${entry.year})` : ''}, watched ${formatWatched(entry.watchedDate)}${entry.rewatch ? ', rewatch' : ''} — on Letterboxd (opens in a new tab)`}
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            ) : (
              <p class="text-muted">No other recent diary entries yet.</p>
            )}
            <p class="mt-12 text-[0.9375rem]">
              <a href={PROFILE_URL} {...newTab} class={linkClass}>
                More on Letterboxd <span aria-hidden="true">↗</span><span class="sr-only">{' (opens in a new tab)'}</span>
              </a>
            </p>
          </HomeSection>
        </div>
      </>
    ) : (
      <section class="mx-auto max-w-[68rem] px-5 pb-24 sm:px-8 md:grid md:grid-cols-[11rem_minmax(0,1fr)] md:gap-x-12">
        <div class="border-t border-rule pt-8 md:col-start-2">
          <p class="text-lg text-muted">Recent films will appear here once they’ve been synced from Letterboxd.</p>
          <p class="mt-4 text-[0.9375rem]">
            <a href={PROFILE_URL} {...newTab} class={linkClass}>
              See my diary on Letterboxd <span aria-hidden="true">↗</span><span class="sr-only">{' (opens in a new tab)'}</span>
            </a>
          </p>
        </div>
      </section>
    )
  }
</PageLayout>

<style>
  /* Dark scrim: strongest at the bottom-left where the text sits. */
  .film-scrim {
    background:
      linear-gradient(to top, rgb(10 12 10 / 0.92) 0%, rgb(10 12 10 / 0.7) 35%, rgb(10 12 10 / 0.15) 75%, rgb(10 12 10 / 0.05) 100%),
      linear-gradient(to right, rgb(10 12 10 / 0.55) 0%, rgb(10 12 10 / 0) 65%);
  }

  .film-link {
    color: var(--color-paper);
    text-decoration: underline;
    text-decoration-color: rgb(243 240 233 / 0.45);
    text-underline-offset: 4px;
  }

  .film-link:hover {
    text-decoration-color: var(--color-paper);
  }

  .film-link:focus-visible {
    outline-color: var(--color-paper);
  }

</style>
